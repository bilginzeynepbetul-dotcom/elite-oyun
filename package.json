{
  "name": "elite-manager",
  "version": "1.0.0",
  "description": "Elite Manager API",
  "main": "server.js",
  "scripts": {
    "start": "npm run migrate && node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "check-db": "node scripts/check-db.js",
    "test": "node scripts/smoke.js",
    "test:integration": "node scripts/integration-test.js",
    "test:reconnect": "node scripts/smoke-reconnect.js",
    "test:all": "node scripts/smoke.js && node scripts/integration-test.js && node scripts/smoke-reconnect.js",
    "test:stress": "node scripts/stress-instant.js",
    "test:stress-load": "node scripts/stress-load.js",
    "test:stress-all": "node scripts/stress-instant.js && node scripts/stress-load.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.7.5"
  }
}

