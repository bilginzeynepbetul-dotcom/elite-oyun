# ============================================================
# Elite Manager — ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# ============================================================

# ZORUNLU — güçlü rastgele secret (ör. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Access token ömrü (varsayılan 2h). Uzun oturum için refresh kullanılır.
# JWT_EXPIRES=2h
# JWT_ACCESS_EXPIRES=2h
# Refresh token ömrü (varsayılan 30d)
# JWT_REFRESH_EXPIRES=30d

# ZORUNLU üretimde — admin kullanıcı adı (ban, sezon reset, forum silme)
ADMIN_USERNAME=your_admin_username

# Veritabanı
DATABASE_URL=postgres://em:em@localhost:5432/elite_manager

# Sunucu
PORT=3000
NODE_ENV=development
# Production'da ZORUNLU — kendi domain'inizi yazın (virgülle birden fazla):
# CORS_ORIGIN=https://your-domain.com
CORS_ORIGIN=

PUBLIC_URL=http://localhost:3000

# Postgres SSL: disable | require (varsayılan, self-signed OK) | verify (CA doğrulama)
# PGSSL=require

# Ücretsiz Elite / mock ödeme — SADECE geliştirme için 1 yapın.
# Production'da 0 veya tanımsız bırakın (varsayılan: kapalı). NODE_ENV=production iken 1 → boot fail.
ELITE_ALLOW_MOCK=0

# Opsiyonel
# MATCH_LOG_LANG=tr
# DB_POOL_MAX=10
# SHUTDOWN_TIMEOUT_MS=10000

# Bağış / Destek Ol
DONATION_IBAN=TR00 0000 0000 0000 0000 0000 00
DONATION_IBAN_NAME=Elite Manager Destek
DONATION_PAPARA=
DONATION_PAPARA_NAME=
DONATION_OTHER=
DONATION_NOTE=Açıklamaya kullanıcı adınızı yazın. Ödeme sonrası Elite sayfasından bağışı bildirin.


# --- Hata izleme / log ---
# LOG_LEVEL=info
# LOG_FORMAT=json
# ERROR_WEBHOOK_URL=
# SECURITY_WEBHOOK_URL=   # hesap kilidi vb. (yoksa ERROR_WEBHOOK_URL)
# ERROR_LOG_FILE=./logs/errors.ndjson
# ERROR_BUFFER_SIZE=100
# ERROR_ADMIN_TOKEN=

# Global API rate limit (auth'lı /api/*)
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000


# --- E-posta doğrulama ---
# PUBLIC_URL doğrulama linkinde kullanılır
# PUBLIC_URL=https://your-domain.com
# EMAIL_FROM=Elite Manager <noreply@yourdomain.com>
# Resend (önerilen, ek paket gerekmez):
# RESEND_API_KEY=re_xxxxxxxx
# veya SMTP (nodemailer paketini kurmanız gerekir: npm i nodemailer):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
# SMTP_URL=
# Giriş için e-posta doğrulaması zorunlu olsun (1=açık):
# EMAIL_REQUIRE_VERIFIED=0

# --- Bakım modu ---
# MAINTENANCE_MODE=1
# MAINTENANCE_MESSAGE=Bakımdayız, kısa süre sonra döneceğiz.
# MAINTENANCE_BYPASS_TOKEN=optional-secret-for-admins
# Not: Admin panel / POST /api/admin/maintenance ile DB üzerinden de açılır (env=1 iken kapatılamaz).

# --- Veri saklama / temizlik (npm run retention) ---
# RETENTION_ANTI_CHEAT_DAYS=90
# RETENTION_ADMIN_AUDIT_DAYS=365
# RETENTION_ACCOUNT_DELETION_LOG_DAYS=730
# RETENTION_CLEAR_EXPIRED_EMAIL_TOKENS=1
# RETENTION_DRY_RUN=0

# --- Giriş kilidi (hesap bazlı) ---
# LOGIN_MAX_FAILURES=8
# LOGIN_LOCK_MINUTES=15
# LOGIN_IP_DELAY_BASE_MS=250
# LOGIN_IP_DELAY_MAX_MS=8000
# LOGIN_IP_FAIL_WINDOW_MS=900000

# --- DB yedek (npm run backup) ---
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BACKUP_PREFIX=elite-oyun

# Socket oturum yeniden doğrulama aralığı (ms, varsayılan 300000 = 5 dk)
# SOCKET_REVALIDATE_MS=300000
# SOCKET_IP_CONNECT_MAX=60
# SOCKET_IP_CONNECT_WINDOW_MS=60000
