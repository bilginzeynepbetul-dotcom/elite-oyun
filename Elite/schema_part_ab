  amount     BIGINT NOT NULL,
  label      VARCHAR(128) NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_ledger_club_ts ON finance_ledger (club_id, created_at DESC);

