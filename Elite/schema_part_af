  username   VARCHAR(32) NOT NULL,
  text       VARCHAR(200) NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_forum_ts ON forum_posts (created_at DESC);

