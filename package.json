{
  "name": "elite-manager",
  "version": "1.0.0",
  "description": "Elite Manager API",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run migrate && node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "check-db": "node scripts/check-db.js",
    "test": "node scripts/smoke.js",
    "test:integration": "node scripts/integration-test.js",
    "test:reconnect": "node scripts/smoke-reconnect.js",
    "test:all": "node scripts/smoke.js && node scripts/integration-test.js && node scripts/smoke-reconnect.js && node scripts/smoke-lockout.js",
    "test:stress": "node scripts/stress-instant.js",
    "test:stress-load": "node scripts/stress-load.js",
    "test:stress-all": "node scripts/stress-instant.js && node scripts/stress-load.js",
    "retention": "node scripts/retention-cleanup.js",
    "retention:dry": "node scripts/retention-cleanup.js --dry-run",
    "backup": "node scripts/backup-db.js",
    "backup:keep7": "node scripts/backup-db.js --keep 7",
    "test:lockout": "node scripts/smoke-lockout.js",
    "post-deploy": "node scripts/post-deploy-check.js",
    "check:deploy": "node scripts/post-deploy-check.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:full": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.7.5"
  }
}
